  "proposed_search_policies": [
    {
      "id": "layer_height_doe_seed",
      "data_class": "proposed_policy_not_experimental_optimum",
      "parameter": "layer_height_over_nozzle_diameter",
      "values": [0.375, 0.5, 0.625],
      "unit": "ratio",
      "must_intersect_with": ["machine", "material", "profile", "mode-specific calibrated layer window"],
      "mode_transfer_validated": false
    },
    {
      "id": "wall_count_doe_seed",
      "data_class": "proposed_policy_not_experimental_optimum",
      "parameter": "wall_line_count",
      "values": [2, 3, 4, 6],
      "unit": "count",
      "must_intersect_with": ["geometry", "load solution", "printable wall layout"]
    },
    {
      "id": "infill_doe_seed",
      "data_class": "proposed_policy_not_experimental_optimum",
      "parameter": "infill_fraction",
      "values": [0.15, 0.3, 0.5, 0.8, 1.0],
      "unit": "ratio",
      "must_intersect_with": ["mechanical feasibility", "mass constraint", "thermal/process feasibility"]
    },
    {
      "id": "temperature_doe_seed",
      "data_class": "proposed_policy_not_experimental_optimum",
      "parameter": "nozzle_temperature",
      "relative_levels": ["intersection_min", "intersection_midpoint", "intersection_max"],
      "must_intersect_with": ["specific SKU/version", "hotend", "profile", "extruder", "calibrated process window"]
    },
    {
      "id": "flow_margin_policy",
      "data_class": "requires_measurement_and_explicit_risk_policy",
      "parameter": "volumetric_flow_limit",
      "universal_numeric_value": null,
      "rule": "Use calibrated lower bound of successful volumetric flow in matching context, with any extra reserve documented separately"
    },
    {
      "id": "safety_factor_policy",
      "data_class": "application_dependent_policy",
      "parameter": "structural_safety_factor",
      "universal_numeric_value": null,
      "rule": "Select from application consequence, model error, load uncertainty and required reliability; does not replace unknown fatigue/creep data"
    }
  ],
  "calibration_methods": [
    {
      "id": "orca_flow_legacy",
      "source_url": "https://github.com/OrcaSlicer/OrcaSlicer/wiki/Calibration/dcd7b12fdc58a3663d2fe69d4d36075eaeebcc9d",
      "formula": "new_ratio = old_ratio * (100 + modifier_percent) / 100",
      "modifier_unit": "percent",
      "test_type": "Legacy Pass 1/Pass 2"
    },
    {
      "id": "orca_flow_yolo",
      "source_url": "https://github.com/OrcaSlicer/OrcaSlicer/wiki/Calibration/dcd7b12fdc58a3663d2fe69d4d36075eaeebcc9d",
      "formula": "new_ratio = old_ratio + modifier_decimal",
      "modifier_unit": "additive_ratio",
      "test_type": "YOLO"
    },
    {
      "id": "klipper_pa_tower",
      "source_url": "https://www.klipper3d.org/Pressure_Advance.html?h=pressure_advance",
      "formula": "pressure_advance = start + measured_height * factor",
      "coefficient_unit": "s",
      "transferable_to_other_firmware_without_validation": false
    }
  ],
