# Copy to .env locally and set your Timeweb AI Gateway key.
LLM_BASE_URL=https://api.timeweb.ai/v1
LLM_API_KEY=
LLM_MODEL=dashscope/qwen3.8-flash

# Optional overrides for the Qwen adapter (the LLM_* values above are supported).
# TIMEWEB_API_KEY=
# QWEN_BASE_URL=https://api.timeweb.ai/v1
# QWEN_MODEL=dashscope/qwen3.8-flash
QWEN_TIMEOUT=60
